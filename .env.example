# ───────────────────────── ScaleX — variáveis de ambiente ─────────────────────────
# Sem NEXT_PUBLIC_SUPABASE_URL a aplicação roda em MODO DEMO:
#   banco local em .data/demo-db.json, uploads em .data/uploads, publicações SIMULADAS.

# URL pública da aplicação (usada em redirects OAuth e e-mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo para assinar cookies de sessão do modo demo e o state do OAuth (>= 32 chars)
SESSION_SECRET=troque-por-uma-string-aleatoria-de-64-caracteres

# ── Supabase (modo real) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor/worker. NUNCA exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media

# ── Instagram API with Instagram Login (Meta) ──
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback
INSTAGRAM_GRAPH_VERSION=v25.0
# Apps novos da Meta: ID da configuração do "API setup with Unified login" (Login do Facebook para Empresas).
# Definido = login unificado (graph.facebook.com). Vazio = modo legado Instagram Login (graph.instagram.com).
INSTAGRAM_CONFIG_ID=
# Opcional: IDs de contas do Instagram para tentar quando a Meta não lista as contas atribuídas (mesmo portfólio do app)
INSTAGRAM_FALLBACK_ACCOUNT_IDS=
# Limite conservador de publicações por conta / 24h aplicado pela ScaleX (Meta: 50–100, ver docs/META_API.md)
INSTAGRAM_DAILY_PUBLISH_LIMIT=25

# Chave AES-256-GCM para criptografar tokens OAuth (32 bytes em base64: `openssl rand -base64 32`)
TOKEN_ENCRYPTION_KEY=

# Protege o endpoint /api/cron/tick (Vercel Cron envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# ─── Cobrança (Cakto) — veja docs/BILLING-CAKTO.md ───
# Segredo do webhook (gerado pela Cakto ao criar o webhook). Sem ele, o checkout fica desligado.
CAKTO_WEBHOOK_SECRET=
# ID curto de cada oferta (o final do link https://pay.cakto.com.br/<ID>). Plano sem oferta não aparece para assinar.
CAKTO_OFFER_STARTER=
CAKTO_OFFER_PRO=
CAKTO_OFFER_SCALE=
# Opcional: credenciais da API (painel Cakto › Integrações › API) para cancelar assinaturas pela ScaleX
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
