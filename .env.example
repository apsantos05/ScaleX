# ───────────────────────── ScaleX — variáveis de ambiente ─────────────────────────
# Sem NEXT_PUBLIC_SUPABASE_URL a aplicação roda em MODO DEMO:
#   banco local em .data/demo-db.json, uploads em .data/uploads, publicações SIMULADAS.

# URL pública da aplicação (usada em redirects OAuth e e-mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo para assinar cookies de sessão do modo demo e o state do OAuth (>= 32 chars)
SESSION_SECRET=troque-por-uma-string-aleatoria-de-64-caracteres

# ── Supabase (modo real) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor/worker. NUNCA exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media

# ── Instagram API with Instagram Login (Meta) ──
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback
INSTAGRAM_GRAPH_VERSION=v25.0
# Limite conservador de publicações por conta / 24h aplicado pela ScaleX (Meta: 50–100, ver docs/META_API.md)
INSTAGRAM_DAILY_PUBLISH_LIMIT=25

# Chave AES-256-GCM para criptografar tokens OAuth (32 bytes em base64: `openssl rand -base64 32`)
TOKEN_ENCRYPTION_KEY=

# Protege o endpoint /api/cron/tick (Vercel Cron envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
